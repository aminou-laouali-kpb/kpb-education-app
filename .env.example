# KPB Education — Docker Compose environment template.
# Copy to `.env`, fill production secrets, and never commit the real file.

# Release identity. In production use the immutable Git SHA or release version.
KPB_IMAGE_TAG=local
# Exact Git commit embedded in immutable impact snapshots once the platform is on.
KPB_BUILD_SHA=
TZ=Africa/Niamey
KPB_ADMIN_API_BASE_URL=https://api.kpbeducation.cloud/api

# PostgreSQL and backups
POSTGRES_USER=kpb
POSTGRES_PASSWORD=
POSTGRES_DB=kpb
BACKUP_KEEP_DAYS=14

# Required API security configuration
KPB_JWT_SECRET=
KPB_JWT_REFRESH_SECRET=
KPB_ADMIN_REFRESH_SECRET=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
# Required in production for hard deletion of Supabase Auth users. Server only.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=https://admin.kpbeducation.cloud
KPB_TRUST_PROXY_HOPS=1

# Mobile release gates
KPB_MIN_APP_VERSION=0.0.0
KPB_ANDROID_STORE_URL=
KPB_IOS_STORE_URL=
KPB_MVP_ONLY=true

# ── Espace « Études en France » (Phase 0) ──────────────────────────────────
# Les deux surfaces du module, éteintes par défaut. Le binaire les embarque déjà
# masquées : ces variables les allument SANS passage par les stores, ce qui est
# tout l'intérêt — une revue App Store prend un à trois jours et peut refuser.
#
# Cinq commutateurs, à ne PAS confondre :
#
#   • KPB_EEF_TEASER_ENABLED — la vitrine « en préparation » (builds 49 et plus).
#   • KPB_EEF_SPACE_ENABLED  — ouvre l'espace RÉEL pour la seule build 54 et les
#     suivantes (`features.eefSpace`). C'est le commutateur du jour d'ouverture.
#     Il ne retire PAS la vitrine des builds plus anciennes, qui ne connaissent
#     pas cette clé. Action dédiée : `eef-space-on` (workflow « VPS ops »), qui
#     refuse d'ouvrir tant qu'aucune formation n'est publiée.
#   • KPB_EEF_HELP_BUBBLE_ENABLED — la bulle « Une question ? » du hub et du
#     catalogue (`features.eefHelpBubble`, build 56 et suivantes). Indépendante
#     de l'ouverture de l'espace : le poser n'ouvre rien, il faut `eefSpace` en
#     plus. Actions : `eef-bubble-on` / `eef-bubble-off` (workflow « VPS ops »).
#   • KPB_EEF_PRIVATE_SCHOOLS_ENABLED — la mention des écoles privées
#     (`features.eefPrivateSchools`, build 56 et suivantes). À n'ouvrir qu'après
#     validation juridique. Actions : `eef-private-schools-on` / `-off`.
#   • KPB_EEF_ENABLED        — l'ANCIEN commutateur. Les builds 49 à 53 le lisent
#     aussi : le poser leur retire la vitrine et leur montre un espace VIDE. Ne
#     plus le poser. (S'il l'est, il ouvre aussi l'espace de la 54.)
KPB_EEF_TEASER_ENABLED=false
KPB_EEF_SPACE_ENABLED=false
KPB_EEF_HELP_BUBBLE_ENABLED=false
KPB_EEF_PRIVATE_SCHOOLS_ENABLED=false
KPB_EEF_ENABLED=false

# « Suivre », Mes suivis et notifications (chantier G) — OUVERTS par défaut :
# seule la valeur `false` les ferme. Servis sous `features` par /config/app pour
# couper une fonction sur les téléphones installés, sans soumission store.
#   • KPB_FOLLOW_PUSH_PRIMER_ENABLED          — feuille d'explication avant la
#     demande d'autorisation, au premier « Suivre » (`followPushPrimer`).
#   • KPB_FOLLOW_OPENING_ALERT_ENABLED        — « Suivre » pose aussi l'alerte
#     d'ouverture (`followOpeningAlert`). Indispensable en mode `legacy`.
#   • KPB_OPENING_ALERT_TOGGLE_ENABLED        — interrupteur « Me prévenir à
#     l'ouverture » de la fiche (`openingAlertToggle`).
#   • KPB_FOLLOWED_SCHOLARSHIPS_ENABLED       — section « Bourses suivies » de
#     Mes suivis (`followedScholarships`).
#   • KPB_NOTIFICATIONS_UNREAD_COUNT_ENABLED  — point de la cloche allumé par
#     les non-lus serveur (`notificationsUnreadCount`).
#   • KPB_FOLLOWED_SCHOLARSHIP_OPT_OUT_ENABLED — ligne de préférence « Bourses
#     que je suis » (`followedScholarshipOptOut`).
#   • KPB_HOME_FOLLOWED_ENTRY_ENABLED         — bouton « Mes suivis » de
#     l'accueil (`homeFollowedEntry`).
KPB_FOLLOW_PUSH_PRIMER_ENABLED=true
KPB_FOLLOW_OPENING_ALERT_ENABLED=true
KPB_OPENING_ALERT_TOGGLE_ENABLED=true
KPB_FOLLOWED_SCHOLARSHIPS_ENABLED=true
KPB_NOTIFICATIONS_UNREAD_COUNT_ENABLED=true
KPB_FOLLOWED_SCHOLARSHIP_OPT_OUT_ENABLED=true
KPB_HOME_FOLLOWED_ENTRY_ENABLED=true
# Blocs de l'accueil (chantier K) — OUVERTS par défaut, seul `false` en coupe un :
# features.homeNextStep, homeScholarships, homeDeadlines, homePartners,
# homeIntelligence, homeParcours, homeCounselor.
KPB_HOME_NEXT_STEP_ENABLED=true
KPB_HOME_SCHOLARSHIPS_ENABLED=true
KPB_HOME_DEADLINES_ENABLED=true
KPB_HOME_PARTNERS_ENABLED=true
KPB_HOME_INTELLIGENCE_ENABLED=true
KPB_HOME_PARCOURS_ENABLED=true
KPB_HOME_COUNSELOR_ENABLED=true

# « Mes 10 bourses » (chantier D) — FERMÉ par défaut : seule la valeur `true`
# (casse et espaces tolérés) l'ouvre. Une seule variable pour deux surfaces :
#   • `features.scholarshipMatch` de /config/app (la carte du test dans l'app) ;
#   • les routes élève /scholarships/match/state|runs|alerts, qui répondent
#     404 `{ disabled: true }` tant qu'elle est coupée.
# À n'ouvrir qu'avec le catalogue structuré (couverture ≥ 90 % des fiches
# publiques) et la validation juridique de la collecte de nationalité.
KPB_SCHOLARSHIP_MATCH_ENABLED=false

# Onboarding « la valeur d'abord » (chantier I3) — FERMÉ par défaut : seule la
# valeur `true` (casse et espaces tolérés) l'ouvre. Servi sous
# `features.onboardingV2` par /config/app. Ouvert : aucun champ pré-rempli sans
# choix de l'élève, « Passer » dès la page 1, erreurs affichées dans le champ.
# Coupé, absent ou backend plus ancien : l'ancien parcours, inchangé.
KPB_ONBOARDING_V2_ENABLED=false

# Fenêtre de campagne, en JOUR NU : AAAA-MM-JJ, sans heure ni décalage.
#
# « La campagne ouvre le 1er octobre » est une date d'horloge murale : elle ne
# désigne pas le même instant à Dakar et à Montréal, et c'est voulu. Une heure
# écrite ici est donc IGNORÉE, pas honorée — et surtout, n'en écrivez pas :
# `2026-10-01T00:00:00+02:00`, l'heure de Paris, est le réflexe naturel pour une
# procédure française, et c'est exactement la saisie qui a fait afficher
# « 30 septembre » à Dakar, Bamako, Abidjan, Niamey et Douala pendant tout le
# temps où le serveur resérialisait ces valeurs en instant UTC.
#
# Une valeur illisible vaut null, jamais une date de repli : l'app n'annonce
# alors AUCUNE date, plutôt qu'une échéance inventée qu'un étudiant utiliserait
# pour organiser son dossier. Un 30 février est refusé et non ramené au 2 mars.
#
# Campagne 2027-2028 : ouverture le 1er octobre 2026, confirmée par les Espaces
# Campus France d'Algérie, du Gabon et du Maroc. La CLÔTURE est délibérément
# laissée vide — elle diverge par pays (Maroc 15 novembre, Rwanda et Maurice
# 15 décembre, Algérie « information à venir »), et une clôture globale ferait
# manquer la campagne à un étudiant marocain. Voir
# docs/eef-campaign-calendar-2027-2028-research.md.
#
# Valeur à poser le jour de la bascule : KPB_EEF_CAMPAIGN_OPENS_AT=2026-10-01
KPB_EEF_CAMPAIGN_OPENS_AT=
KPB_EEF_CAMPAIGN_CLOSES_AT=

# Pays où la procédure est SUSPENDUE : l'app y remplace la date d'ouverture par
# une mise en garde et un relais conseiller. Liste séparée par des virgules,
# noms ou codes indifféremment (la comparaison normalise casse et accents).
#
# Au 21/08/2026 : le Niger — la page officielle de l'ambassade indique que la
# dénonciation de la convention du centre qui hébergeait Campus France rend
# impossible le traitement des dossiers d'étudiants nigériens. Poser
# « Niger,NE ». Une réouverture se traite en retirant la valeur.
KPB_EEF_SUSPENDED_COUNTRIES=

# Liens OFFICIELS affichés par l'app (sous la date d'ouverture, sous la mise en
# garde de suspension, dans la mention de non-affiliation). https uniquement —
# toute autre valeur est ignorée. Laisser VIDE : le serveur sert alors des liens
# vérifiés (https://www.campusfrance.org/fr, et la page de l'ambassade pour le
# Niger). À renseigner seulement si la plateforme change d'adresse ou qu'un pays
# s'ajoute à la liste ci-dessus.
#   KPB_EEF_PLATFORM_URL=https://…
#   KPB_EEF_SUSPENDED_SOURCES=Niger|https://…;Autre pays|https://…
KPB_EEF_PLATFORM_URL=
KPB_EEF_SUSPENDED_SOURCES=

# Version RECOMMANDÉE de l'app (x.y.z) : en dessous, un bandeau NON bloquant
# invite à mettre à jour, avec un lien vers le store. Vide = aucun bandeau.
# C'est le levier des passages 2.3.0 → 2.4.0 → build du forum, SANS relever
# KPB_MIN_APP_VERSION (qui bloque l'app derrière un écran qu'on ne ferme pas).
# À poser seulement quand la build est DISPONIBLE sur les deux stores.
KPB_RECOMMENDED_APP_VERSION=

# Visas étudiants AMÉRICAINS (F, M, J) suspendus par nationalité : l'avis des
# fiches établissement, formation et pays des États-Unis (`usVisaSuspension` de
# /config/app). Laisser VIDE : le serveur sert la liste vérifiée le 17/10/2026
# (proclamation 10998 — BF, ML, NE, TD, CG, BJ, CI, SN, GA, MR, BI, TG), datée,
# avec la page du Département d'État. Pour la changer sans nouvelle build :
#   KPB_US_VISA_SUSPENDED_COUNTRIES=BF,ML,NE,…   (codes ISO alpha-2 ; `none` = aucun avis)
#   KPB_US_VISA_SUSPENSION_VERIFIED_AT=AAAA-MM-JJ (jour de VOTRE vérification)
#   KPB_US_VISA_SUSPENSION_SOURCE_URL=https://travel.state.gov/…
# Une liste posée sans date est servie sans date (l'app n'en invente pas).
KPB_US_VISA_SUSPENDED_COUNTRIES=
KPB_US_VISA_SUSPENSION_VERIFIED_AT=
KPB_US_VISA_SUSPENSION_SOURCE_URL=

# Scholarship auto-refresh (KPB-161): true = run the 48h scrape of vetted
# sources (GreatYop, MastereTn). Independent of KPB_MVP_ONLY, so enabling it
# never unlocks other MVP-gated surfaces. Admin "Refresh now" works regardless,
# as does the daily catalog-freshness SLA check (WARN log on overdue items).
KPB_SCHOLARSHIP_REFRESH_ENABLED=false

# Daily "Bourse du jour" push (KPB-162): true = push the featured scholarship at
# 19h local time. OFF by default until the Home card + opt-out toggle ship; the
# GET /scholarships/daily endpoint works regardless.
KPB_DAILY_SCHOLARSHIP_ENABLED=false

# Weekly digest (KPB-163): true = send the Monday 08h-local recap (push + email
# via Resend). Skips any student with nothing new — never sends an empty digest.
# Requires RESEND_API_KEY for the email half; the push half works without it.
KPB_WEEKLY_DIGEST_ENABLED=false

# Weekly match recompute (KPB-168): true = recompute each active student's top
# matches every Wednesday and push ONLY when a school enters/leaves the top 3 or
# changes zone. Never pushes on a first computation, nor when nothing moved.
KPB_MATCH_RECOMPUTE_ENABLED=false
# "Récit de la semaine" (KPB-169): true = push the editorially featured Parcours
# story on Sunday 18h local. Nothing is sent when no story is featured in admin.
# The GET /content/parcours/featured endpoint works regardless of this flag.
KPB_PARCOURS_WEEKLY_ENABLED=false

# Annonce d'ouverture des bourses suivies (chantier C). « Suivre » = favori +
# alerte d'ouverture + rappels de date limite.
#   legacy (défaut)   : le chemin d'avant — envoi immédiat aux seules alertes
#                       « M'avertir » non mises en sourdine, sans heures calmes ;
#   outbox_alerts     : envoi programmé (annulable pendant le délai) puis
#                       worker, alertes seulement ;
#   outbox_followers  : idem, favoris ∪ alertes. Lancer d'abord
#                       `npm run follow:mirror-alerts -- --dry-run`, puis --apply.
# Basculer seulement APRÈS le déploiement de l'admin (le nouvel admin envoie
# `notify`, qu'un backend plus ancien refuse).
KPB_SCHOLARSHIP_OPENING_MODE=legacy
# Arrêt d'urgence du worker (programmations et push en attente patientent).
KPB_PUSH_OUTBOX_ENABLED=true
# Réglages (vide = défaut du code, entre parenthèses). Bornes :
# backend/src/modules/scholarships-index/opening/scholarship-opening.contract.ts
#   KPB_OPENING_HOLD_SECONDS (120)            délai annulable avant l'envoi
#   KPB_OPENING_CONFIRM_THRESHOLD (500)       au-delà : confirmation saisie, admins seulement
#   KPB_OPENING_COALESCE_MINUTES (30)         au plus 1 push d'ouverture par étudiant sur cette fenêtre
#   KPB_OPENING_MAX_PER_DAY (2)               au plus N push d'ouverture par étudiant et par jour local
#   KPB_OPENING_RENOTIFY_DAYS (30)            pas de nouvelle annonce de la même bourse avant N jours
#   KPB_OPENING_FANOUT_CYCLES_PER_TICK (5)    annonces programmées traitées par passage
#   KPB_OPENING_FANOUT_MAX_LATENESS_HOURS (24) une annonce en retard de plus est abandonnée
#   KPB_PUSH_OUTBOX_TTL_HOURS (72)            un push encore en attente après N h expire
#   KPB_PUSH_OUTBOX_TICK_BUDGET_MS (60000)    durée d'un passage du worker
#   KPB_PUSH_OUTBOX_CONCURRENCY (8)           envois simultanés
#   KPB_PUSH_OUTBOX_BATCH (200)               lignes réservées par lot
#   KPB_PUSH_OUTBOX_LEASE_MS (300000)         bail d'une réservation (≥ budget + 120 s)
#   KPB_PUSH_OUTBOX_MAX_ATTEMPTS (5)          appels au fournisseur avant échec
KPB_OPENING_HOLD_SECONDS=
KPB_OPENING_CONFIRM_THRESHOLD=
KPB_OPENING_COALESCE_MINUTES=
KPB_OPENING_MAX_PER_DAY=
KPB_OPENING_RENOTIFY_DAYS=
KPB_OPENING_FANOUT_CYCLES_PER_TICK=
KPB_OPENING_FANOUT_MAX_LATENESS_HOURS=
KPB_PUSH_OUTBOX_TTL_HOURS=
KPB_PUSH_OUTBOX_TICK_BUDGET_MS=
KPB_PUSH_OUTBOX_CONCURRENCY=
KPB_PUSH_OUTBOX_BATCH=
KPB_PUSH_OUTBOX_LEASE_MS=
KPB_PUSH_OUTBOX_MAX_ATTEMPTS=
# Heures calmes des push, en heures locales (pays de résidence, UTC+0 par
# défaut) : rien entre START et END. Vide = 21 et 8.
KPB_PUSH_QUIET_START=
KPB_PUSH_QUIET_END=

# Optional integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Push : compte de service Firebase (console Firebase → Paramètres du projet →
# Comptes de service → Générer une clé). JSON encodé en base64 sur une ligne :
#   base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT_JSON=
# Repli pour les versions de l'app antérieures à FCM (à vider ensuite).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
# Newsletter bourses (Mautic auto-hébergé — stack marketing du même VPS).
# Activer l'API dans Mautic (Configuration → API Settings → Basic Auth) et
# créer le segment ; laisser vide pour désactiver la synchronisation.
MAUTIC_BASE_URL=https://mautic.kpbeducation.cloud
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
MAUTIC_SEGMENT_ID=
KPB_MAGIC_LINK_FROM=KPB Education <no-reply@kpbeducation.cloud>
# Lien web optionnel ajouté aux emails magic-link. NE PAS renseigner tant
# qu'aucun vérificateur web n'existe : app.kpbeducation.cloud pointe sur
# l'hébergement marketing (185.158.133.1), pas sur l'API — le lien serait mort.
# Le code à 6 chiffres et le lien kpb:// suffisent.
KPB_MAGIC_LINK_WEB_BASE=
KPB_CAMPAIGN_MAIL_FROM=
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=
# Playlists supplémentaires servies par /content/youtube-playlist (ids séparés
# par des virgules). Tout autre id demandé retombe sur YOUTUBE_PLAYLIST_ID.
YOUTUBE_ALLOWED_PLAYLIST_IDS=
# Quotas IA quotidiens par utilisateur (vide = 30 outils / 10 relectures /
# 10 orientations).
KPB_AI_DAILY_QUOTA_TOOLS=
KPB_AI_DAILY_QUOTA_DOCUMENT_REVIEW=
KPB_AI_DAILY_QUOTA_ORIENTATION=
KPB_KAYAK_API_KEY=
KPB_KAYAK_BASE_URL=https://api.kayak.com
KPB_KAYAK_USER_AGENT=

# Private object storage. Leave blank to use the persisted local volume.
KPB_S3_ENDPOINT=
KPB_S3_REGION=fr-par
KPB_S3_BUCKET=
KPB_S3_ACCESS_KEY_ID=
KPB_S3_SECRET_ACCESS_KEY=
KPB_S3_PUBLIC_BASE_URL=
KPB_S3_FORCE_PATH_STYLE=false
KPB_UPLOADS_DIR=/app/uploads
KPB_UPLOADS_PUBLIC_URL=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Competition Readiness — fail closed by default.
KPB_COMPETITION_READINESS_ENABLED=false
KPB_SUCCESS_LAB_ENABLED=false
KPB_APPLICATION_ARTIFACTS_ENABLED=false
KPB_APPLICATION_ARTIFACT_MAX_BYTES=10485760
KPB_STUDY_REVIEW_ENABLED=false
KPB_STUDY_REVIEW_SLA_HOURS=48
KPB_EVIDENCE_ACCESS_TTL_SECONDS=60
KPB_EVIDENCE_ACCESS_SECRET=
KPB_AI_DIAGNOSTIC_ENABLED=false
KPB_AI_DIAGNOSTIC_KILL_SWITCH=true
KPB_AI_DIAGNOSTIC_MODEL=
KPB_AI_DIAGNOSTIC_MIN_AGE=13
KPB_AI_DIAGNOSTIC_PROMPT_VERSION=success-lab-v1
KPB_AI_DIAGNOSTIC_MAX_INPUT_CHARS=8000
KPB_AI_DIAGNOSTIC_MAX_BILLABLE_INPUT_TOKENS=12000
KPB_AI_DIAGNOSTIC_MAX_OUTPUT_TOKENS=220
KPB_AI_DIAGNOSTIC_DAILY_CALL_CAP=100
KPB_AI_DIAGNOSTIC_USER_DAILY_ATTEMPT_CAP=3
KPB_AI_DIAGNOSTIC_MONTHLY_BUDGET_MICROS_USD=0
KPB_AI_DIAGNOSTIC_PRICE_VERSION=
KPB_AI_DIAGNOSTIC_CRITERIA_MAX_AGE_DAYS=180
KPB_SUCCESS_LAB_PILOT_COUNTRIES=NE,SN,CI
KPB_SUCCESS_LAB_ROLLOUT_PERCENT=0
KPB_FEATURE_ROLLOUT_SECRET=
KPB_ANALYTICS_ACTOR_SECRET=
# Durable domain-event worker. Defaults are suitable for one or several API
# replicas; tune only with backlog/latency evidence.
KPB_OUTBOX_BATCH_SIZE=10
KPB_OUTBOX_LEASE_MS=300000
KPB_OUTBOX_MAX_ATTEMPTS=8
KPB_OUTBOX_RETRY_BASE_MS=5000
KPB_OUTBOX_RETRY_CAP_MS=3600000
KPB_OUTCOME_EVIDENCE_ENABLED=false
KPB_OUTCOME_EVIDENCE_MAX_PENDING_PER_WORKSPACE=20
KPB_OUTCOME_REFERENCE_HMAC_SECRET=
KPB_IMPACT_PUBLIC_STATS_ENABLED=false

# Rapport d'erreurs de la console admin (DSN Sentry, public par nature car
# embarqué dans le bundle navigateur). Vide = désactivé.
KPB_ADMIN_SENTRY_DSN=

# ── Compétition ambassadeurs (parrainage) ───────────────────────────────────
# docs/runbook-campagne-ambassadeurs.md. Facultatives : vide = défaut.
#   REFERRAL_CODE_HOURLY_LIMIT (30)        rattachements max par code et par heure (429 au-delà)
#   REFERRAL_SIGNAL_RETENTION_DAYS (180)   conservation des empreintes anti-fraude — À VALIDER
#   KPB_REFERRAL_SIGNAL_SECRET (KPB_JWT_SECRET) clé HMAC des empreintes
#   AMBASSADOR_SELF_ACTIVATION_ENABLED (false) true = rouvre l'auto-activation (programme rémunéré)
REFERRAL_CODE_HOURLY_LIMIT=
REFERRAL_SIGNAL_RETENTION_DAYS=
KPB_REFERRAL_SIGNAL_SECRET=
AMBASSADOR_SELF_ACTIVATION_ENABLED=
