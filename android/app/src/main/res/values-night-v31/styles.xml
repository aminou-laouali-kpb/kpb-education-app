<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ en mode sombre : identique à values-v31, l'app étant en
         thème clair seul. Ce fichier doit exister : le qualificatif « night »
         prime sur la version d'API, donc sans lui values-night servirait sur
         Android 12+ en mode sombre, sans fond ni logo de marque.
         Garde : test/release/launch_screen_test.dart. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/kpb_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kpb_launch_background</item>
    </style>
</resources>
