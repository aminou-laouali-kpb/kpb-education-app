# KPB Education — backend environment.
# Copy to `.env` and fill in. In production the app FAILS LOUD on boot if any
# value under "REQUIRED" is missing. Never commit a real .env.

# ─────────────────────────── REQUIRED ───────────────────────────
NODE_ENV=production
PORT=3000
# Exact Git commit; required once Competition Readiness is enabled.
KPB_BUILD_SHA=

# Postgres connection. With docker-compose these are assembled from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (set them in the ROOT .env).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kpb?schema=public

# Secrets — generate long random strings (e.g. `openssl rand -hex 32`).
KPB_JWT_SECRET=
KPB_JWT_REFRESH_SECRET=
KPB_ADMIN_REFRESH_SECRET=

# Supabase Auth (students/parents authenticate via Supabase). SUPABASE_URL is
# mandatory; SUPABASE_JWT_SECRET is only needed for legacy HS256 projects.
# SUPABASE_SERVICE_ROLE_KEY is the SECRET key (Dashboard → Project Settings →
# API keys → "service_role" / sb_secret_…) — NOT the publishable/anon key. It
# lets account deletion hard-delete a user's Supabase Auth identity
# (GDPR/store). It is mandatory in production: bootstrap and Compose fail closed
# when it is missing. Keep it server-side; never copy it into Flutter/admin/web.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed origins for CORS (admin web app, etc.).
CORS_ORIGINS=https://admin.kpbeducation.cloud

# API is behind one trusted Nginx reverse proxy in production. This lets
# Express/Nest use the real client IP for rate limiting without trusting an
# arbitrary X-Forwarded-For value from the public internet.
KPB_TRUST_PROXY_HOPS=1

# ────────────────────── FEATURE INTEGRATIONS ──────────────────────
# Each block is optional — leave blank to disable that feature.

# AI coach / document review — OpenAI-compatible chat completions.
# Default provider is OpenRouter; requests are pinned to no-data-retention
# providers (data_collection=deny) because prompts can concern minors.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
# Optional overrides:
# LLM_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_TIMEOUT_MS=18000
# Hidden reasoning is disabled on OpenRouter (it burned max_tokens and
# returned no JSON). Set to true only for a model that requires it.
# LLM_REASONING_ENABLED=false
# Legacy Groq fallback — only read when LLM_API_KEY is empty.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Push notifications — FCM en direct (gratuit). Compte de service Firebase
# (console Firebase → Paramètres du projet → Comptes de service → Générer une
# clé), en JSON brut ou encodé en base64 sur une ligne : base64 -w0 sa.json
FCM_SERVICE_ACCOUNT_JSON=
# Repli OneSignal pour les versions de l'app antérieures à FCM (à vider ensuite).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Magic-link email (Resend)
RESEND_API_KEY=
# Newsletter bourses (Mautic auto-hébergé — stack marketing du même VPS).
# Activer l'API dans Mautic (Configuration → API Settings → Basic Auth) et
# créer le segment ; laisser vide pour désactiver la synchronisation.
MAUTIC_BASE_URL=https://mautic.kpbeducation.cloud
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
MAUTIC_SEGMENT_ID=
KPB_MAGIC_LINK_FROM=KPB Education <no-reply@kpbeducation.cloud>
KPB_MAGIC_LINK_WEB_BASE=https://app.kpbeducation.cloud
# Campaign email sender; falls back to KPB_MAGIC_LINK_FROM when blank.
KPB_CAMPAIGN_MAIL_FROM=
# Correctifs 57 (XC-06) — e-mails des campagnes PROMOTIONNELLES de l'admin :
# chaque e-mail porte un lien de désinscription signé (HMAC) et l'en-tête
# List-Unsubscribe. Secret : KPB_PROMOTIONS_UNSUBSCRIBE_SECRET, sinon
# KPB_JWT_SECRET ; sans aucun des deux, l'e-mail promotionnel n'est PAS envoyé.
# KPB_PUBLIC_API_URL : adresse publique de l'API, préfixe /api compris
# (défaut https://api.kpbeducation.cloud/api).
KPB_PROMOTIONS_UNSUBSCRIBE_SECRET=
KPB_PUBLIC_API_URL=

# Antivirus for uploads (ClamAV daemon, INSTREAM over TCP). Leave the host
# blank to skip scanning (dev). In docker-compose it defaults to the `clamav`
# sidecar. When set, scanning is FAIL-CLOSED: an unreachable scanner rejects
# uploads with 503 instead of letting unscanned files through.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Force-update gate (mobile). Raise KPB_MIN_APP_VERSION to force clients below
# it onto the stores; leave at 0.0.0 (or blank) to never block.
#
# ORDER MATTERS: the update screen is not dismissible and its only button needs
# a working store URL. Set both URLs, confirm them in the live response of
# GET /api/config/app, and only then raise KPB_MIN_APP_VERSION. Blank falls back
# to the published listings below, which is correct — but never assume it.
KPB_MIN_APP_VERSION=
KPB_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.karatou.android
KPB_IOS_STORE_URL=https://apps.apple.com/app/id1128659292

# Competition Readiness / "Mon atelier de candidature". These gates are
# fail-closed: production stays dark until each capability is explicitly on.
KPB_COMPETITION_READINESS_ENABLED=false
KPB_SUCCESS_LAB_ENABLED=false
KPB_APPLICATION_ARTIFACTS_ENABLED=false
KPB_APPLICATION_ARTIFACT_MAX_BYTES=10485760
KPB_STUDY_REVIEW_ENABLED=false
KPB_STUDY_REVIEW_SLA_HOURS=48
KPB_EVIDENCE_ACCESS_TTL_SECONDS=60
KPB_EVIDENCE_ACCESS_SECRET=
KPB_AI_DIAGNOSTIC_ENABLED=false
KPB_AI_DIAGNOSTIC_KILL_SWITCH=true
KPB_AI_DIAGNOSTIC_MODEL=
KPB_AI_DIAGNOSTIC_MIN_AGE=13
KPB_AI_DIAGNOSTIC_PROMPT_VERSION=success-lab-v1
KPB_AI_DIAGNOSTIC_MAX_INPUT_CHARS=8000
KPB_AI_DIAGNOSTIC_MAX_BILLABLE_INPUT_TOKENS=12000
KPB_AI_DIAGNOSTIC_MAX_OUTPUT_TOKENS=220
KPB_AI_DIAGNOSTIC_DAILY_CALL_CAP=100
KPB_AI_DIAGNOSTIC_USER_DAILY_ATTEMPT_CAP=3
KPB_AI_DIAGNOSTIC_MONTHLY_BUDGET_MICROS_USD=0
KPB_AI_DIAGNOSTIC_PRICE_VERSION=
KPB_AI_DIAGNOSTIC_CRITERIA_MAX_AGE_DAYS=180
KPB_SUCCESS_LAB_PILOT_COUNTRIES=NE,SN,CI
KPB_SUCCESS_LAB_ROLLOUT_PERCENT=0
KPB_FEATURE_ROLLOUT_SECRET=
# Required for pseudonymous, stable analytics attribution during a pilot.
KPB_ANALYTICS_ACTOR_SECRET=
# Durable domain-event worker. PostgreSQL leases prevent duplicate processing
# when several API replicas poll concurrently.
KPB_OUTBOX_BATCH_SIZE=10
KPB_OUTBOX_LEASE_MS=300000
KPB_OUTBOX_MAX_ATTEMPTS=8
KPB_OUTBOX_RETRY_BASE_MS=5000
KPB_OUTBOX_RETRY_CAP_MS=3600000
KPB_OUTCOME_EVIDENCE_ENABLED=false
KPB_OUTCOME_EVIDENCE_MAX_PENDING_PER_WORKSPACE=20
# Required in production; references are normalized and HMACed before storage.
KPB_OUTCOME_REFERENCE_HMAC_SECRET=
KPB_IMPACT_PUBLIC_STATS_ENABLED=false

# Parcours videos (YouTube Data API)
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=

# Flight price estimator (Kayak Price-Insights affiliate API). The backend
# proxies /api/flights/* so the app never sees the secret. Leave the api key or
# base url blank to disable — the app falls back to a browser deeplink.
KPB_KAYAK_API_KEY=
# Host only; the affiliate baseUri path is appended by the service.
KPB_KAYAK_BASE_URL=https://api.kayak.com
# User-Agent string Kayak assigned the affiliate (affects click/impression
# tracking). A sane default is used if left blank.
KPB_KAYAK_USER_AGENT=

# Document uploads — EITHER S3-compatible object storage…
KPB_S3_ENDPOINT=
KPB_S3_REGION=
KPB_S3_BUCKET=
KPB_S3_ACCESS_KEY_ID=
KPB_S3_SECRET_ACCESS_KEY=
# Only used to map database records created before private downloads. New
# uploads store an opaque storage:// reference and do not need a public bucket.
KPB_S3_PUBLIC_BASE_URL=
KPB_S3_FORCE_PATH_STYLE=
# …OR local disk (used when the S3 vars are unset)
KPB_UPLOADS_DIR=
# Legacy mapping only; this no longer exposes files through the API.
KPB_UPLOADS_PUBLIC_URL=

# MVP launch lock (true = hide V1.1+ modules). Defaults to enabled.
KPB_MVP_ONLY=true

# Scholarship auto-refresh (KPB-161): true = run the 48h scrape of vetted
# sources (GreatYop, MastereTn). Independent of KPB_MVP_ONLY, so enabling it
# never unlocks other MVP-gated surfaces. Admin "Refresh now" works regardless,
# as does the daily catalog-freshness SLA check (WARN log on overdue items).
KPB_SCHOLARSHIP_REFRESH_ENABLED=false

# Daily "Bourse du jour" push (KPB-162): true = push the featured scholarship at
# 19h local time. OFF by default until the Home card + opt-out toggle ship; the
# GET /scholarships/daily endpoint works regardless.
KPB_DAILY_SCHOLARSHIP_ENABLED=false

# Weekly digest (KPB-163): true = send the Monday 08h-local recap (push + email
# via Resend). Skips any student with nothing new — never sends an empty digest.
# Requires RESEND_API_KEY for the email half; the push half works without it.
KPB_WEEKLY_DIGEST_ENABLED=false

# Weekly match recompute (KPB-168): true = recompute each active student's top
# matches every Wednesday and push ONLY when a school enters/leaves the top 3 or
# changes zone. Never pushes on a first computation, nor when nothing moved.
KPB_MATCH_RECOMPUTE_ENABLED=false
# "Récit de la semaine" (KPB-169): true = push the editorially featured Parcours
# story on Sunday 18h local. Nothing is sent when no story is featured in admin.
# The GET /content/parcours/featured endpoint works regardless of this flag.
KPB_PARCOURS_WEEKLY_ENABLED=false

# Annonce d'ouverture des bourses suivies (chantier C). « Suivre » = favori +
# alerte d'ouverture + rappels de date limite.
#   legacy (défaut)   : le chemin d'avant — envoi immédiat aux seules alertes
#                       « M'avertir » non mises en sourdine, sans heures calmes ;
#   outbox_alerts     : envoi programmé (annulable pendant le délai) puis
#                       worker, alertes seulement ;
#   outbox_followers  : idem, favoris ∪ alertes. Lancer d'abord
#                       `npm run follow:mirror-alerts -- --dry-run`, puis --apply.
# Basculer seulement APRÈS le déploiement de l'admin (le nouvel admin envoie
# `notify`, qu'un backend plus ancien refuse).
KPB_SCHOLARSHIP_OPENING_MODE=legacy
# Arrêt d'urgence du worker (programmations et push en attente patientent).
KPB_PUSH_OUTBOX_ENABLED=true
# Réglages (vide = défaut du code, entre parenthèses). Bornes :
# backend/src/modules/scholarships-index/opening/scholarship-opening.contract.ts
#   KPB_OPENING_HOLD_SECONDS (120)            délai annulable avant l'envoi
#   KPB_OPENING_CONFIRM_THRESHOLD (500)       au-delà : confirmation saisie, admins seulement
#   KPB_OPENING_COALESCE_MINUTES (30)         au plus 1 push d'ouverture par étudiant sur cette fenêtre
#   KPB_OPENING_MAX_PER_DAY (2)               au plus N push d'ouverture par étudiant et par jour local
#   KPB_OPENING_RENOTIFY_DAYS (30)            pas de nouvelle annonce de la même bourse avant N jours
#   KPB_OPENING_FANOUT_CYCLES_PER_TICK (5)    annonces programmées traitées par passage
#   KPB_OPENING_FANOUT_MAX_LATENESS_HOURS (24) une annonce en retard de plus est abandonnée
#   KPB_PUSH_OUTBOX_TTL_HOURS (72)            un push encore en attente après N h expire
#   KPB_PUSH_OUTBOX_TICK_BUDGET_MS (60000)    durée d'un passage du worker
#   KPB_PUSH_OUTBOX_CONCURRENCY (8)           envois simultanés
#   KPB_PUSH_OUTBOX_BATCH (200)               lignes réservées par lot
#   KPB_PUSH_OUTBOX_LEASE_MS (300000)         bail d'une réservation (≥ budget + 120 s)
#   KPB_PUSH_OUTBOX_MAX_ATTEMPTS (5)          appels au fournisseur avant échec
KPB_OPENING_HOLD_SECONDS=
KPB_OPENING_CONFIRM_THRESHOLD=
KPB_OPENING_COALESCE_MINUTES=
KPB_OPENING_MAX_PER_DAY=
KPB_OPENING_RENOTIFY_DAYS=
KPB_OPENING_FANOUT_CYCLES_PER_TICK=
KPB_OPENING_FANOUT_MAX_LATENESS_HOURS=
KPB_PUSH_OUTBOX_TTL_HOURS=
KPB_PUSH_OUTBOX_TICK_BUDGET_MS=
KPB_PUSH_OUTBOX_CONCURRENCY=
KPB_PUSH_OUTBOX_BATCH=
KPB_PUSH_OUTBOX_LEASE_MS=
KPB_PUSH_OUTBOX_MAX_ATTEMPTS=
# Heures calmes des push, en heures locales (pays de résidence, UTC+0 par
# défaut) : rien entre START et END. Vide = 21 et 8.
KPB_PUSH_QUIET_START=
KPB_PUSH_QUIET_END=

# ── Compétition ambassadeurs (parrainage) ───────────────────────────────────
# Voir docs/runbook-campagne-ambassadeurs.md. Toutes facultatives (vide = défaut).
#   REFERRAL_CODE_HOURLY_LIMIT (30)        rattachements max par code et par heure (429 au-delà)
#   REFERRAL_SIGNAL_RETENTION_DAYS (180)   conservation des empreintes anti-fraude (≥ 30) — validée le 18/10/2026
#   KPB_REFERRAL_SIGNAL_SECRET (KPB_JWT_SECRET) clé HMAC des empreintes (IP, plage, appareil)
#   AMBASSADOR_SELF_ACTIVATION_ENABLED (false) true = rouvre l'auto-activation (programme rémunéré)
REFERRAL_CODE_HOURLY_LIMIT=
REFERRAL_SIGNAL_RETENTION_DAYS=
KPB_REFERRAL_SIGNAL_SECRET=
AMBASSADOR_SELF_ACTIVATION_ENABLED=
