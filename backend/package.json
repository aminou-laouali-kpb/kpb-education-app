{
  "name": "kpb-education-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:countries": "bash scripts/seed-countries.sh",
    "seed:counsellors": "bash -lc 'set -a; source .env; set +a; PSQL_URL=$(printf \"%s\" \"$DATABASE_URL\" | sed -E \"s/[?&]schema=[^&]*//g\" | sed -E \"s/\\?&/?/g\"); psql \"$PSQL_URL\" -f scripts/seed-kpb-counsellors.sql'",
    "import:omnes": "ts-node scripts/import-omnes-template.ts",
    "import:omnes:bundled": "ts-node scripts/import-omnes-template.ts scripts/data/omnes_fall_26.xlsx",
    "seed:omnes": "ts-node scripts/seed-omnes-programs.ts",
    "import:omnes-spring": "ts-node scripts/import-omnes-spring.ts",
    "import:igensia": "ts-node scripts/import-igensia.ts",
    "import:north-america": "ts-node scripts/import-north-america.ts",
    "dedupe:omnes": "ts-node scripts/dedupe-omnes-programs.ts",
    "roll:omnes-fall-2027": "ts-node scripts/roll-omnes-fall-2027.ts",
    "reconcile:program-ids": "ts-node scripts/reconcile-program-ids.ts",
    "import:universiapolis": "ts-node scripts/import-universiapolis.ts",
    "fix:mundiapolis-levels": "ts-node scripts/fix-mundiapolis-levels.ts",
    "backfill:tuition-eur": "ts-node scripts/backfill-tuition-min-eur.ts",
    "reviews:purge-orphans": "ts-node scripts/purge-orphan-reviews.ts",
    "backfill:seed-institutions": "ts-node scripts/backfill-seed-institutions.ts",
    "import:partners": "ts-node scripts/import-partner-universities.ts",
    "seed:partners": "ts-node scripts/seed-partner-schools.ts",
    "seed:countries-m5": "ts-node scripts/seed-countries-m5.ts",
    "seed:catalogue-unique": "ts-node scripts/seed-catalogue-unique.ts",
    "seed:catalog": "npm run seed:countries-m5 && npm run seed:catalogue-unique",
    "verify:catalog": "ts-node scripts/verify-catalog-country-refs.ts",
    "eef:fetch": "ts-node scripts/fetch-eef-catalog.ts",
    "eef:enrich": "ts-node scripts/enrich-eef-catalog.ts",
    "eef:validate:structure": "ts-node scripts/validate-eef-catalog.ts --structure-only",
    "verify:eef": "ts-node scripts/validate-eef-catalog.ts",
    "eef:import:dry-run": "ts-node --transpile-only scripts/import-eef-catalog.ts --dry-run",
    "eef:import": "ts-node --transpile-only scripts/import-eef-catalog.ts --apply",
    "eef:backfill:cycle:dry-run": "ts-node --transpile-only scripts/backfill-eef-cycle.ts --dry-run",
    "eef:backfill:cycle": "ts-node --transpile-only scripts/backfill-eef-cycle.ts --apply",
    "eef:backfill:admission:dry-run": "ts-node --transpile-only scripts/backfill-eef-admission.ts --dry-run",
    "eef:backfill:admission": "ts-node --transpile-only scripts/backfill-eef-admission.ts --apply",
    "eef:backfill:search:dry-run": "ts-node --transpile-only scripts/backfill-eef-search-text.ts --dry-run",
    "eef:backfill:search": "ts-node --transpile-only scripts/backfill-eef-search-text.ts --apply",
    "eef:backfill": "ts-node --transpile-only scripts/backfill-eef-enrichment.ts",
    "eef:purge-pending": "ts-node --transpile-only scripts/purge-eef-pending.ts",
    "eef:publish": "ts-node --transpile-only scripts/publish-eef-catalog.ts",
    "eef:check-sources": "ts-node --transpile-only scripts/check-eef-source-pages.ts",
    "eef:reconcile": "ts-node --transpile-only scripts/reconcile-eef-catalog.ts",
    "scholarships:validate:structure": "ts-node scripts/validate-scholarship-catalog.ts --structure-only",
    "scholarships:validate:merge-gate": "ts-node scripts/validate-scholarship-catalog.ts --structure-only --ignore-clock",
    "verify:scholarships": "ts-node scripts/validate-scholarship-catalog.ts",
    "scholarships:import:dry-run": "ts-node scripts/import-scholarship-catalog.ts --dry-run",
    "scholarships:import": "ts-node scripts/import-scholarship-catalog.ts --apply",
    "catalog:import": "node dist/cli/scholarships-catalog.cli.js import",
    "catalog:reconcile": "node dist/cli/scholarships-catalog.cli.js reconcile",
    "catalog:publish": "node dist/cli/scholarships-catalog.cli.js publish",
    "catalog:deactivate-legacy": "node dist/cli/scholarships-catalog.cli.js deactivate-legacy",
    "catalog:switch": "node dist/cli/scholarships-catalog.cli.js switch",
    "follow:mirror-alerts": "node dist/cli/scholarship-follow-mirror.cli.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "jest",
    "test:integration:privacy": "jest --runInBand src/modules/profiles/profiles.postgres.spec.ts src/modules/profiles/profiles-residues.postgres.spec.ts src/modules/competition-readiness/analytics/storage-purge-reconciliation.postgres.spec.ts src/modules/counsellors/counsellors.reviews.postgres.spec.ts src/modules/counsellors/orphan-reviews.postgres.spec.ts src/modules/app-builds/app-builds.postgres.spec.ts",
    "test:integration:catalog-reads": "jest --runInBand src/modules/scholarships-index/scholarships-public-reads.postgres.spec.ts src/modules/scholarship-match/scholarship-match-migration.postgres.spec.ts src/modules/scholarship-match/scholarship-match-api.postgres.spec.ts",
    "test:integration:catalog-reconcile": "jest --runInBand src/cli/scholarships-catalog.reconcile.postgres.spec.ts",
    "test:integration:eef-provenance": "KPB_RUN_POSTGRES_INTEGRATION=true jest --runInBand src/common/eef-provenance.postgres.spec.ts src/modules/etudes-en-france/catalog/eef-pending-purge.postgres.spec.ts src/modules/etudes-en-france/catalog/eef-catalog.reconcile.postgres.spec.ts src/modules/etudes-en-france/publication/eef-publication.postgres.spec.ts src/modules/etudes-en-france/publication/eef-delegated-publication.postgres.spec.ts src/modules/etudes-en-france/search/eef-search.postgres.spec.ts src/modules/etudes-en-france/shortlist/eef-shortlist.postgres.spec.ts src/modules/etudes-en-france/etudes-en-france.postgres.spec.ts src/modules/notifications/campaign-audience.postgres.spec.ts",
    "test:integration:opening-fanout": "KPB_RUN_POSTGRES_INTEGRATION=true jest --runInBand '(scholarship-opening|scholarship-follow|push-outbox|milestone-reminder)[^/]*\\.postgres\\.spec\\.ts$'",
    "test:integration:migration-upgrade": "ts-node scripts/verify-competition-readiness-populated-upgrade.ts",
    "test:integration:referral-campaign": "KPB_RUN_POSTGRES_INTEGRATION=true jest --runInBand src/modules/referrals/campaigns/referral-campaign.postgres.spec.ts src/modules/referrals/campaigns/profile-completion.postgres.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.3",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "socket.io-parser": "^4.2.7",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9"
  }
}
